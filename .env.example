# Reference only: this app does not automatically load .env files.
AI_BASE_URL=http://127.0.0.1:8002
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
AI_CONNECT_TIMEOUT_SECONDS=3
AI_READ_TIMEOUT_SECONDS=130
AI_WRITE_TIMEOUT_SECONDS=10
AI_POOL_TIMEOUT_SECONDS=3
AI_REQUEST_TIMEOUT_SECONDS=135
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
AUTH_REQUEST_TIMEOUT_SECONDS=10
# BE 서버 환경/secret manager 전용 비밀키
# FE·AI·브라우저·로그·응답 전달 금지, 설정 누락 시 신규 쓰기 차단
# SUPABASE_SECRET_KEY=
DB_REQUEST_TIMEOUT_SECONDS=10
# memory 기본값 유지. 005 적용/실DB 검증 후에만 supabase 선택
SESSION_STORE_MODE=memory

# 보상은 회원별 서울 날짜의 최초 확정 일기에 한 번만 30코인·물방울 1개를 지급한다.
# 수정·삭제·같은 날 재작성으로 중복 지급하지 않는다(v0.4 SQL 후보 포함 기준).
# 별도 날짜 설정 없음. SQL 후보의 기존 일기 소급 보류 목록을 먼저 검증해야 한다.
